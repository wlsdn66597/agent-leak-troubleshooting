# 이번 과제(agent-leak-app) 실행 경로 설정 — setup_env.sh / lib.sh 가 자동으로 읽는다.
# 이전 과제 설정(/etc/profile.d/agent-app.sh 가 로그인 시 AGENT_HOME=/home/agent-admin/agent-app 등을 export)을
# 덮어쓰기 위해 기존 값과 관계없이 항상 이 값으로 고정한다. 경로를 바꾸려면 이 파일을 수정한다.
export AGENT_HOME="$HOME/agent-leak"
export AGENT_LOG_DIR="$AGENT_HOME/logs"
export APP_BIN="$AGENT_HOME/agent-leak-app"   # 제공받은 바이너리를 이 위치에 둔다
export PROC_NAME="agent-leak-app"
